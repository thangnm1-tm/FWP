# Security Guidance:
# 1. Never commit real credentials or production secrets to Git.
# 2. In staging/production, set strong, random, high-entropy values for all passwords
#    and JWT secrets. Do not leave the default fallback strings.
# 3. Restrict host port bindings in docker-compose.yml (default is 127.0.0.1). Do not
#    expose postgres/redis/ml to 0.0.0.0 on public interfaces without firewall/VPN.
# 4. Set CORS_ORIGINS to your trusted frontend domain(s) (e.g. https://fwp.ptit.edu.vn).

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
POSTGRES_USER=fwp_user
POSTGRES_PASSWORD=fwp_password_change_me
POSTGRES_DB=fwp_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
BACKEND_BIND=127.0.0.1
# Comma-separated CORS allow-list (REQUIRED in production, no wildcard credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=your_jwt_secret_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Email (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@fwp.app
# Use "demo" only for local development; it does not send an email.
OTP_DELIVERY_MODE=demo
DEMO_OTP=123456

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ML Service
ML_BIND=127.0.0.1
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=3000
ML_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ML_RELOAD_TOKEN=generate_a_long_random_token_for_model_reload

# FCM
FCM_PROJECT_ID=your_firebase_project_id
# JSON service-account value on one line. Never commit a real key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_firebase_project_id"}

# Automatic ML retraining from impression-backed production feedback
RETRAIN_INTERVAL_HOURS=24
RETRAIN_MIN_EVENTS=100

# App
ALLOWED_EMAIL_DOMAINS=stu.ptit.edu.vn
NODE_ENV=development
